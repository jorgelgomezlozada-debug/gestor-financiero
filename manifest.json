{<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestor Financiero COP</title>

  <!-- Enlace al Manifiesto físico -->
  <link rel="manifest" href="./manifest.json">
  <meta name="theme-color" content="#4f46e5">

  <!-- Registro del Service Worker -->
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js')
          .then(reg => console.log('SW registrado!', reg))
          .catch(err => console.log('Error SW:', err));
      });
    }
  </script>
  "name": "Gestor Financiero COP",
  "short_name": "Gestor COP",
  "description": "Control de ingresos, egresos y presupuestos en pesos colombianos",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#4f46e5",
  "orientation": "portrait",
  "id": "/gestor-financiero/",
  "icons": [
    {
      "src": "https://cdn-icons-png.flaticon.com/512/2845/2845700.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
